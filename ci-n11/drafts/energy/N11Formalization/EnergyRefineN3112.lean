  constructor <;> decide +kernel
def pk : Fin K → MPacket := ![pk1,pk1,pk1,pk3,pk4]
theorem pk_ok : ∀ l, (sub l).terminal = true → MValid (pk l) ∧ (pk l).D = (sub l).db ∧ (pk l).S = 1048576 := by
  intro l hl
