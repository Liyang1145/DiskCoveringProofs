theorem terminal : (DBMSourceTree.data 3112).terminal = true := by decide +kernel
theorem node_radius
    (y : Fin 9 → ℝ) (hy0 : ∀ q, 0 ≤ y q) (hy1 : ∑ q, y q = 1)
    (hc : FlashLeafSplit.Cell (DBMTreeKernel.matrix DBMSourceTree.data 4096 3112)
      (FlashLeafSplit.tlift y)) (C Z : Fin 11 → Point) (r : ℝ)
    (hf : ResumeNetwork.Feasible (SourceChartIsometry.chartAnchors y) C Z r) :
    SourceExactRoot.sourceRadius < r
  := Paid16MatrixCellCertificate.node_radius_of_refinement 3112 sub 0 sub_valid root_scaled pk pk_ok y hy0 hy1 hc C Z r hf
def newIDs : Finset (Fin 5011) := {3112}
theorem new_terminal (n : Fin 5011) (hn : n ∈ newIDs) : (DBMSourceTree.data n).terminal = true := by
  rw [Finset.mem_singleton.mp hn]; exact terminal
theorem new_radius (n : Fin 5011) (hn : n ∈ newIDs)
    (y : Fin 9 → ℝ) (hy0 : ∀ q, 0 ≤ y q) (hy1 : ∑ q, y q = 1)
    (hc : FlashLeafSplit.Cell (DBMTreeKernel.matrix DBMSourceTree.data 4096 n)
      (FlashLeafSplit.tlift y)) (C Z : Fin 11 → Point) (r : ℝ)
    (hf : ResumeNetwork.Feasible (SourceChartIsometry.chartAnchors y) C Z r) :
