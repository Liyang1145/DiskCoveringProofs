theorem terminal : (DBMSourceTree.data 3795).terminal = true := by decide +kernel
theorem node_radius
    (y : Fin 9 → ℝ) (hy0 : ∀ q, 0 ≤ y q) (hy1 : ∑ q, y q = 1)
    (hc : FlashLeafSplit.Cell (DBMTreeKernel.matrix DBMSourceTree.data 4096 3795)
