theorem terminal : (DBMSourceTree.data 4684).terminal = true := by decide +kernel
theorem node_radius
    (y : Fin 9 → ℝ) (hy0 : ∀ q, 0 ≤ y q) (hy1 : ∑ q, y q = 1)
    (hc : FlashLeafSplit.Cell (DBMTreeKernel.matrix DBMSourceTree.data 4096 4684)
      (FlashLeafSplit.tlift y)) (C Z : Fin 11 → Point) (r : ℝ)
    (hf : ResumeNetwork.Feasible (SourceChartIsometry.chartAnchors y) C Z r) :
    SourceExactRoot.sourceRadius < r
  := Paid16MatrixCellCertificate.node_radius_of_refinement 4684 sub 0 sub_valid root_scaled pk pk_ok y hy0 hy1 hc C Z r hf
