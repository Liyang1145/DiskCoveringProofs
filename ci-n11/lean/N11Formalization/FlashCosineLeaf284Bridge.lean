theorem rowb_dbm (r : Fin 4) : rowb r = dbm (rowFrom r) (rowTo r) := by
  fin_cases r <;> norm_num [rowb, dbm, rowFrom, rowTo]

theorem rowAy (y : Fin 9 → ℝ) (r : Fin 4) :
    (∑ q : Fin 9, (rowA r q : ℝ) * y q) = tval y (rowTo r) - tval y (rowFrom r) := by
  fin_cases r <;>
    simp [rowA, rowA0, rowA1, rowA2, rowA3, rowFrom, rowTo, tval, Fin.sum_univ_succ] <;> ring

theorem tval_eq_tlift (y : Fin 9 → ℝ) (k : Fin 10) :
    tval y k = N11Formalization.FlashLeafSplit.tlift y k := by
  simp only [tval, N11Formalization.FlashLeafSplit.tlift, Finset.sum_filter]

