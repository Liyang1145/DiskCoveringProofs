theorem endpoint_sound (a b c v : ℚ) (x : ℝ)
    (hlo : (a : ℝ) ≤ x) (hhi : x ≤ (b : ℝ)) :
    (endpointLo a b c v : ℝ) ≤ (c : ℝ) * x + (v : ℝ) := by
  unfold endpointLo
  split_ifs with hc
  · have hcR : (0 : ℝ) ≤ (c : ℝ) := by exact_mod_cast hc
    push_cast
    linarith [mul_le_mul_of_nonneg_left hlo hcR]
  · have hcR : (c : ℝ) ≤ 0 := by exact_mod_cast (le_of_lt (lt_of_not_ge hc))
    push_cast
    linarith [mul_le_mul_of_nonpos_left hhi hcR]

theorem lam_nonneg (r : Fin 4) : 0 ≤ lam r := by fin_cases r <;> norm_num [lam]
theorem lam90_nonneg (r : Fin 90) : 0 ≤ lam90 r := by fin_cases r <;> norm_num [lam90]
theorem lam90_sparse (r : Fin 90) :
    (r : ℕ) = 17 ∨ (r : ℕ) = 58 ∨ (r : ℕ) = 65 ∨ (r : ℕ) = 75 ∨ lam90 r = 0 := by
  fin_cases r <;> norm_num [lam90]
theorem zhat_nonneg (q : Fin 9) : 0 ≤ zhat q := by fin_cases q <;> norm_num [zhat]
theorem pair_coeff (k : Fin 36) :
    cl k = wt k * sl k * (((iOf k : ℕ) : ℚ) - ((jOf k : ℕ) : ℚ)) ∧
    cv k = wt k * cc k := by
  fin_cases k <;> norm_num [cl, cv, wt, sl, cc, iOf, jOf]
theorem i_le_j (k : Fin 36) : (iOf k : ℕ) ≤ (jOf k : ℕ) := by
  fin_cases k <;> norm_num [iOf, jOf]
theorem zhat_eq (q : Fin 9) :
    zhat q = ∑ k : Fin 36, if (iOf k : ℕ) ≤ (q : ℕ) ∧ (q : ℕ) < (jOf k : ℕ)
      then wt k * sl k else 0 := by
  fin_cases q <;> simp [zhat, iOf, jOf, wt, sl, Fin.sum_univ_succ] <;> norm_num
theorem rho_eq (q : Fin 9) : rho q = ∑ r : Fin 4, lam r * rowA r q := by
  fin_cases q <;> norm_num [rho, lam, rowA, rowA0, rowA1, rowA2, rowA3, Fin.sum_univ_succ]

theorem lamB_eq : lamB = ((-50711465553 : ℚ) / 4000000000000) := by
