    (hcell : N11Formalization.FlashLeafSplit.Cell (fun i j => (dbm i j : ℝ))
      (N11Formalization.FlashLeafSplit.tlift y)) :
    ∀ r : Fin 4, ∑ q : Fin 9, (rowA r q : ℝ) * y q ≤ (rowb r : ℝ) := by
  intro r
  rw [rowAy, rowb_dbm, tval_eq_tlift, tval_eq_tlift]
  exact hcell (rowFrom r) (rowTo r)

noncomputable def pairAffine (y : Fin 9 → ℝ) : ℝ :=
  ∑ k : Fin 36, (wt k : ℝ) * ((sl k : ℝ) * zval y (iOf k) (jOf k) + (cc k : ℝ))

theorem pair_expand (y : Fin 9 → ℝ) (k : Fin 36) :
    (wt k : ℝ) * ((sl k : ℝ) * zval y (iOf k) (jOf k) + (cc k : ℝ)) =
      (cl k : ℝ) * Lc + (cv k : ℝ) +
        Dc * (∑ q : Fin 9, if (iOf k : ℕ) ≤ (q : ℕ) ∧ (q : ℕ) < (jOf k : ℕ)
          then ((wt k : ℝ) * (sl k : ℝ)) * y q else 0) := by
  have hc : (cl k : ℝ) = (wt k : ℝ) * (sl k : ℝ) *
      (((iOf k : ℕ) : ℝ) - ((jOf k : ℕ) : ℝ)) := by exact_mod_cast (pair_coeff k).1
  have hv : (cv k : ℝ) = (wt k : ℝ) * (cc k : ℝ) := by exact_mod_cast (pair_coeff k).2
  rw [zval_eq, tval_sub y (i_le_j k), hc, hv]
  have hs : (∑ q : Fin 9, if (iOf k : ℕ) ≤ (q : ℕ) ∧ (q : ℕ) < (jOf k : ℕ)
          then ((wt k : ℝ) * (sl k : ℝ)) * y q else 0) =
      ((wt k : ℝ) * (sl k : ℝ)) *
        (∑ q : Fin 9, if (iOf k : ℕ) ≤ (q : ℕ) ∧ (q : ℕ) < (jOf k : ℕ) then y q else 0) := by
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun q _ => ?_
    split_ifs <;> simp
  rw [hs]
  simp only [Fin.val_castSucc]
  ring

theorem affine_identity (y : Fin 9 → ℝ) : pairAffine y = affine Lc Dc y := by
  have hs : (∑ k : Fin 36, ∑ q : Fin 9,
      if (iOf k : ℕ) ≤ (q : ℕ) ∧ (q : ℕ) < (jOf k : ℕ)
        then ((wt k : ℝ) * (sl k : ℝ)) * y q else 0) =
      ∑ q : Fin 9, (zhat q : ℝ) * y q := by
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun q _ => ?_
    have hz : (zhat q : ℝ) = ∑ k : Fin 36,
        if (iOf k : ℕ) ≤ (q : ℕ) ∧ (q : ℕ) < (jOf k : ℕ)
          then (wt k : ℝ) * (sl k : ℝ) else 0 := by
      rw [zhat_eq]
      push_cast
      apply Finset.sum_congr rfl
      intro k hk
      split_ifs <;> push_cast <;> rfl
    rw [hz, Finset.sum_mul]
    refine Finset.sum_congr rfl fun k _ => ?_
    split_ifs <;> simp
  unfold pairAffine affine
  simp_rw [pair_expand]
  rw [Finset.sum_add_distrib, ← Finset.mul_sum, hs, Finset.mul_sum]
  simp only [mul_assoc]

theorem leaf284_affine_gt (y : Fin 9 → ℝ)
    (hy0 : ∀ q, 0 ≤ y q) (hy1 : ∑ q, y q = 1)
    (hcell : N11Formalization.FlashLeafSplit.Cell (fun i j => (dbm i j : ℝ))
      (N11Formalization.FlashLeafSplit.tlift y)) :
    (T : ℝ) ^ 2 < pairAffine y := by
  rw [affine_identity]
  exact affine_gt Lc Dc y L_mem D_mem.1 hy0 hy1 (rows_of_cell y hcell)

/- Mathematical negative control: altering row58 λ by 10^-12 without changing
its b=3/4 makes the recorded frozen evaluation disagree by 3/(4*10^12).
This is sensitivity of the bound, not a claim that the modified dual is invalid. -/
def mutatedLower : ℚ := lower284 - (1 / 10^12) * rowb 1
theorem perturbation_eq : lower284 - mutatedLower = 3 / (4 * 10^12) := by
  unfold mutatedLower
  norm_num [rowb]
theorem perturbation_nonzero : lower284 ≠ mutatedLower := by
  have h := perturbation_eq
  intro he
  rw [he, sub_self] at h
  norm_num at h
