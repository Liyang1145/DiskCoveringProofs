noncomputable def affine (L D : ℝ) (y : Fin 9 → ℝ) : ℝ :=
    (∑ k : Fin 36, ((cl k : ℝ) * L + (cv k : ℝ))) + ∑ q : Fin 9, (D * (zhat q : ℝ)) * y q

theorem affine_lower (L D : ℝ) (y : Fin 9 → ℝ)
    (hL : (Lq : ℝ) ≤ L ∧ L ≤ (LQ : ℝ)) (hD : (Dq : ℝ) ≤ D)
    (hy0 : ∀ q, 0 ≤ y q) (hy1 : ∑ q, y q = 1)
    (hrow : ∀ r : Fin 4, ∑ q : Fin 9, (rowA r q : ℝ) * y q ≤ (rowb r : ℝ)) :
    (lower284 : ℝ) ≤ affine L D y := by
  have hp := lp_step9 rowA rowb lam (fun q => D * (zhat q : ℝ)) (m284 : ℝ) y
    (fun r => by exact_mod_cast lam_nonneg r) hrow hy0 hy1 (reduced_cost D hD)
  have hb : (lamB : ℝ) = ∑ r : Fin 4, (lam r : ℝ) * (rowb r : ℝ) := by
    simp only [lamB, Rat.cast_sum, Rat.cast_mul]
  rw [← hb] at hp
  have hf := f0_sound L hL
  have he : (lower284 : ℝ) = (f0Lo : ℝ) - (lamB : ℝ) + (m284 : ℝ) := by
    simp only [lower284, Rat.cast_add, Rat.cast_sub]
  unfold affine
  linarith

theorem affine_gt (L D : ℝ) (y : Fin 9 → ℝ)
    (hL : (Lq : ℝ) ≤ L ∧ L ≤ (LQ : ℝ)) (hD : (Dq : ℝ) ≤ D)
    (hy0 : ∀ q, 0 ≤ y q) (hy1 : ∑ q, y q = 1)
    (hrow : ∀ r : Fin 4, ∑ q : Fin 9, (rowA r q : ℝ) * y q ≤ (rowb r : ℝ)) :
    (T : ℝ) ^ 2 < affine L D y := by
  have h : (T : ℝ) ^ 2 < (lower284 : ℝ) := by exact_mod_cast frozen_gt_T2
  exact lt_of_lt_of_le h (affine_lower L D y hL hD hy0 hy1 hrow)

