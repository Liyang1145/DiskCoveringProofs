theorem reduced_cost (D : ℝ) (hD : (Dq : ℝ) ≤ D) (q : Fin 9) :
    (m284 : ℝ) ≤ D * (zhat q : ℝ) + ∑ r : Fin 4, (lam r : ℝ) * (rowA r q : ℝ) := by
  have hn : (m284 : ℝ) ≤ (zhat q : ℝ) * (Dq : ℝ) + (rho q : ℝ) := by
    exact_mod_cast rational_min q
  have hz : (0 : ℝ) ≤ (zhat q : ℝ) := by exact_mod_cast zhat_nonneg q
  have hr : (rho q : ℝ) = ∑ r : Fin 4, (lam r : ℝ) * (rowA r q : ℝ) := by
    exact_mod_cast rho_eq q
  rw [← hr]
  linarith [mul_le_mul_of_nonneg_left hD hz]

theorem f0_sound (L : ℝ) (hL : (Lq : ℝ) ≤ L ∧ L ≤ (LQ : ℝ)) :
    (f0Lo : ℝ) ≤ ∑ k : Fin 36, ((cl k : ℝ) * L + (cv k : ℝ)) := by
  unfold f0Lo
