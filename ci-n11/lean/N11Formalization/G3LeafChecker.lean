import Mathlib
import N11Formalization.LeafAgg
import N11Formalization.G3ArcConstants

namespace N11Formalization.G3LeafChecker

open N11Formalization.LeafAgg

open N11Formalization.G3ArcConstants
/-! ## 1. The rounding bridges (literal-free) -/

/-- Integer lower bound on a scaled rational  =>  rational upper bound on the ratio.
This is the exact form of `hcR`, `hd`, `hrmin` in `leafCheck_sound_unscaled`. -/
theorem rat_le_of_int_le_mul {c : ℤ} {q : ℚ} {D : ℤ} (hD : 0 < D) (h : (c : ℚ) ≤ q * D) :
    (c : ℝ) / (D : ℝ) ≤ (q : ℝ) := by
  have hD' : (0 : ℝ) < (D : ℝ) := by exact_mod_cast hD
  have h1 : ((c : ℚ) : ℝ) ≤ ((q * D : ℚ) : ℝ) := by exact_mod_cast h
  push_cast at h1
  exact (div_le_iff₀ hD').mpr h1

/-- Integer upper bound on a scaled rational  =>  rational lower bound on the ratio.
This is the exact form of `hlamB`, `hT2`. -/
theorem le_rat_div_of_mul_le_int {m : ℤ} {q : ℚ} {D : ℤ} (hD : 0 < D) (h : q * D ≤ (m : ℚ)) :
    (q : ℝ) ≤ (m : ℝ) / (D : ℝ) := by
  have hD' : (0 : ℝ) < (D : ℝ) := by exact_mod_cast hD
  have h1 : ((q * D : ℚ) : ℝ) ≤ ((m : ℚ) : ℝ) := by exact_mod_cast h
  push_cast at h1
  exact (le_div_iff₀ hD').mpr h1

/-- **The floor hypothesis is free**: an integer DEFINED as `floor (q*D)` bounds `q*D`. -/
theorem floor_le_mul (q : ℚ) (D : ℤ) : ((⌊q * D⌋ : ℤ) : ℚ) ≤ q * D := Int.floor_le _

/-- **The ceil hypothesis is free**: an integer DEFINED as `ceil (q*D)` bounds `q*D`. -/
theorem mul_le_ceil (q : ℚ) (D : ℤ) : q * D ≤ ((⌈q * D⌉ : ℤ) : ℚ) := Int.le_ceil _

/-! ## 2. `hcR0` is REDUNDANT (so the sign correspondence is NOT a per-leaf obligation) -/

/-- **Soundness in unscaled form, WITHOUT the hypothesis `hcR0`.**

`leafCheck_sound_unscaled` carries `hcR0 : forall i, b i = false -> cR i <= 0`.  That
hypothesis is never used: in the negative-coefficient branch the proof needs only
`c i <= 0` (which the checker's own sign-table comparison `hb` supplies) plus
`c i <= cR i * D`.  Dropping it matters *mathematically*, not just cosmetically: with the
generator's `c i = floor (D * cR i)` the implication `c i <= 0 -> cR i <= 0` is FALSE
(e.g. `0 < cR i < 1/D` gives `c i = 0`), so `hcR0` could NOT have been discharged
leaf-by-leaf from the recorded data.  (Statement identical to
`N11Formalization.LeafAgg.leafCheck_sound_unscaled` minus `hcR0`.) -/
theorem leafCheck_sound_unscaled_noSign {n : ℕ} {c d : Fin n → ℤ} {b : Fin n → Bool}
    {Llo Lhi D lamB rmin T2 : ℤ} {cR dR : Fin n → ℝ} {L lamBR rminR T2R : ℝ}
    (h : leafCheck c d b Llo Lhi D lamB rmin T2 = true)
    (hD : (0 : ℝ) < D)
    (hLlo : (Llo : ℝ) / D ≤ L) (hLhi : L ≤ (Lhi : ℝ) / D)
    (hLlo0 : 0 ≤ (Llo : ℝ) / D)
    (hcR : ∀ i, (c i : ℝ) / D ≤ cR i)
    (hd : ∀ i, (d i : ℝ) / D ≤ dR i)
    (hlamB : lamBR ≤ (lamB : ℝ) / D) (hrmin : (rmin : ℝ) / D ≤ rminR)
    (hT2 : T2R ≤ (T2 : ℝ) / D) :
    ((∑ i, (cR i * L + dR i)) - lamBR + rminR) * D ^ 2 > T2R * D ^ 2 := by
  have h' := h
  simp only [leafCheck, Bool.and_eq_true, decide_eq_true_eq] at h'
  obtain ⟨⟨⟨hDpos, _hLH⟩, hb⟩, hsum⟩ := h'
  have hDposR : (0 : ℝ) < (D : ℝ) := by exact_mod_cast hDpos
  have hterm : ∀ i, (c i : ℝ) * (if b i then (Llo : ℝ) else (Lhi : ℝ)) + (d i : ℝ) * D
      ≤ (cR i * L + dR i) * D ^ 2 := by
    intro i
    have hbi : b i = decide (0 < c i) := by simpa using hb i
    by_cases hpos : 0 < c i
    · have hbtrue : b i = true := by rw [hbi]; exact decide_eq_true hpos
      rw [hbtrue]
      have hci0 : (0 : ℝ) ≤ (c i : ℝ) := by exact_mod_cast hpos.le
      have hcRi : (c i : ℝ) ≤ cR i * D := (div_le_iff₀ hDposR).mp (hcR i)
      have hdi : (d i : ℝ) ≤ dR i * D := (div_le_iff₀ hDposR).mp (hd i)
      have hLloD : (Llo : ℝ) ≤ L * D := (div_le_iff₀ hDposR).mp hLlo
      have hLn : (0 : ℝ) ≤ L := le_trans hLlo0 hLlo
      have h0 : (0 : ℝ) ≤ L * D := mul_nonneg hLn hDposR.le
      have s1 : (c i : ℝ) * (Llo : ℝ) ≤ (c i : ℝ) * (L * D) :=
        mul_le_mul_of_nonneg_left hLloD hci0
      have s2 : (c i : ℝ) * (L * D) ≤ (cR i * L) * D ^ 2 :=
        calc (c i : ℝ) * (L * D) ≤ (cR i * D) * (L * D) :=
              mul_le_mul_of_nonneg_right hcRi h0
          _ = (cR i * L) * D ^ 2 := by ring
      have s3 : (d i : ℝ) * D ≤ (dR i) * D ^ 2 :=
        calc (d i : ℝ) * D ≤ (dR i * D) * D := mul_le_mul_of_nonneg_right hdi hDposR.le
          _ = (dR i) * D ^ 2 := by ring
      calc (c i : ℝ) * (Llo : ℝ) + (d i : ℝ) * D
          ≤ (cR i * L) * D ^ 2 + (dR i) * D ^ 2 := add_le_add (le_trans s1 s2) s3
        _ = (cR i * L + dR i) * D ^ 2 := by ring
    · have hbfalse : b i = false := by rw [hbi]; exact decide_eq_false hpos
      rw [hbfalse]
      have hci0 : (c i : ℝ) ≤ 0 := by exact_mod_cast (not_lt.mp hpos)
      have hcRi : (c i : ℝ) ≤ cR i * D := (div_le_iff₀ hDposR).mp (hcR i)
      have hdi : (d i : ℝ) ≤ dR i * D := (div_le_iff₀ hDposR).mp (hd i)
      have hLhiD : L * D ≤ (Lhi : ℝ) := (le_div_iff₀ hDposR).mp hLhi
      have hLn : (0 : ℝ) ≤ L := le_trans hLlo0 hLlo
      have h0 : (0 : ℝ) ≤ L * D := mul_nonneg hLn hDposR.le
      have s1 : (c i : ℝ) * (Lhi : ℝ) ≤ (c i : ℝ) * (L * D) :=
        mul_le_mul_of_nonpos_left hLhiD hci0
      have s2 : (c i : ℝ) * (L * D) ≤ (cR i * L) * D ^ 2 :=
        calc (c i : ℝ) * (L * D) ≤ (cR i * D) * (L * D) :=
              mul_le_mul_of_nonneg_right hcRi h0
          _ = (cR i * L) * D ^ 2 := by ring
      have s3 : (d i : ℝ) * D ≤ (dR i) * D ^ 2 :=
        calc (d i : ℝ) * D ≤ (dR i * D) * D := mul_le_mul_of_nonneg_right hdi hDposR.le
          _ = (dR i) * D ^ 2 := by ring
      calc (c i : ℝ) * (Lhi : ℝ) + (d i : ℝ) * D
          ≤ (cR i * L) * D ^ 2 + (dR i) * D ^ 2 := add_le_add (le_trans s1 s2) s3
        _ = (cR i * L + dR i) * D ^ 2 := by ring
  have hsumR : (∑ i, ((c i : ℝ) * (if b i then (Llo : ℝ) else (Lhi : ℝ)) + (d i : ℝ) * D))
      ≤ (∑ i, (cR i * L + dR i)) * D ^ 2 := by
    rw [Finset.sum_mul]
    exact Finset.sum_le_sum (fun i _ => hterm i)
  have hsumZ : ((lsum c d Llo Lhi D : ℤ) : ℝ) - (lamB : ℝ) * D + (rmin : ℝ) * D
      > (T2 : ℝ) * D := by exact_mod_cast hsum
  have hcast : ((lsum c d Llo Lhi D : ℤ) : ℝ)
      = ∑ i, ((c i : ℝ) * (if b i then (Llo : ℝ) else (Lhi : ℝ)) + (d i : ℝ) * D) := by
    rw [lsum]
    push_cast
    apply Finset.sum_congr rfl
    intro i _
    have hbi : b i = decide (0 < c i) := by simpa using hb i
    by_cases hpos : 0 < c i
    · have hbt : b i = true := by rw [hbi]; exact decide_eq_true hpos
      simp [hbt, hpos]
    · have hbf : b i = false := by rw [hbi]; exact decide_eq_false hpos
      simp [hbf, hpos]
  rw [hcast] at hsumZ
  have hlamB' : lamBR * D ≤ (lamB : ℝ) := (le_div_iff₀ hDposR).mp hlamB
  have hrmin' : (rmin : ℝ) ≤ rminR * D := (div_le_iff₀ hDposR).mp hrmin
  have hT2' : T2R * D ≤ (T2 : ℝ) := (le_div_iff₀ hDposR).mp hT2
  have hb1 : T2R * D ^ 2 ≤ (T2 : ℝ) * D := by nlinarith [hT2', hDposR]
  have hb2 : lamBR * D ^ 2 ≤ (lamB : ℝ) * D := by nlinarith [hlamB', hDposR]
  have hb3 : (rmin : ℝ) * D ≤ rminR * D ^ 2 := by nlinarith [hrmin', hDposR]
  have hgoal : T2R * D ^ 2 + lamBR * D ^ 2 - rminR * D ^ 2
      ≤ (T2 : ℝ) * D + (lamB : ℝ) * D - (rmin : ℝ) * D := by linarith
  nlinarith [hsumR, hsumZ, hgoal, hDposR]

/-- The unscaled (division-free) corollary of the strengthened theorem. -/
theorem leafCheck_sound_noSign {n : ℕ} {c d : Fin n → ℤ} {b : Fin n → Bool}
    {Llo Lhi D lamB rmin T2 : ℤ} {cR dR : Fin n → ℝ} {L lamBR rminR T2R : ℝ}
    (h : leafCheck c d b Llo Lhi D lamB rmin T2 = true)
    (hD : (0 : ℝ) < D)
    (hLlo : (Llo : ℝ) / D ≤ L) (hLhi : L ≤ (Lhi : ℝ) / D)
    (hLlo0 : 0 ≤ (Llo : ℝ) / D)
    (hcR : ∀ i, (c i : ℝ) / D ≤ cR i)
    (hd : ∀ i, (d i : ℝ) / D ≤ dR i)
    (hlamB : lamBR ≤ (lamB : ℝ) / D) (hrmin : (rmin : ℝ) / D ≤ rminR)
    (hT2 : T2R ≤ (T2 : ℝ) / D) :
    (∑ i, (cR i * L + dR i)) - lamBR + rminR > T2R := by
  have hscaled := leafCheck_sound_unscaled_noSign h hD hLlo hLhi hLlo0 hcR hd hlamB hrmin hT2
  have hsq : (0 : ℝ) < (D : ℝ) ^ 2 := by positivity
  nlinarith [hscaled, hsq]

/-! ## 3. The parameterized consumer (rational source data -> real leaf bound) -/

/-- **The hookup, parameterized.**  All hypotheses are either leaf-independent or of the
form "recorded integer bounds source rational"; nothing refers to a particular leaf. -/
theorem leafBound_of_check {n : ℕ} {c d : Fin n → ℤ} {b : Fin n → Bool}
    {Llo Lhi D lamB rmin T2 : ℤ} {qc qd : Fin n → ℚ} {lamBR rminR T2R : ℚ} {L : ℝ}
    (h : leafCheck c d b Llo Lhi D lamB rmin T2 = true)
    (hD : 0 < D)
    (hLlo : (Llo : ℝ) / (D : ℝ) ≤ L) (hLhi : L ≤ (Lhi : ℝ) / (D : ℝ))
    (hLlo0 : 0 ≤ (Llo : ℝ) / (D : ℝ))
    (hcR : ∀ i, (c i : ℚ) ≤ qc i * D) (hd : ∀ i, (d i : ℚ) ≤ qd i * D)
    (hlamB : lamBR * D ≤ (lamB : ℚ)) (hrmin : (rmin : ℚ) ≤ rminR * D)
    (hT2 : T2R * D ≤ (T2 : ℚ)) :
    (∑ i, ((qc i : ℝ) * L + (qd i : ℝ))) - (lamBR : ℝ) + (rminR : ℝ) > (T2R : ℝ) := by
  have hD' : (0 : ℝ) < (D : ℝ) := by exact_mod_cast hD
  refine leafCheck_sound_noSign h hD' hLlo hLhi hLlo0 ?_ ?_ ?_ ?_ ?_
  · intro i
    exact rat_le_of_int_le_mul hD (hcR i)
  · intro i
    exact rat_le_of_int_le_mul hD (hd i)
  · exact le_rat_div_of_mul_le_int hD hlamB
  · exact rat_le_of_int_le_mul hD hrmin
  · exact le_rat_div_of_mul_le_int hD hT2


/-! ## 5. THE ASSEMBLED DELIVERABLE: floor/ceil-defined data => zero per-leaf proof work -/

/-- **The leaf bound, from a passing kernel check on floor/ceil-rounded source data.**

Given the source RATIONALS of one leaf (`qc`, `qd` = the line coefficients, `lamBq` = the
dual value `lambda.b`, `rminq` = the residual minimum), define the integers the generator
emits as the outward roundings `floor (D*q)` / `ceil (D*q)`.  If the kernel check
`leafCheck` passes on those integers, then the leaf bound holds -- and every hookup
hypothesis is discharged here by a GENERIC lemma, so there is no per-leaf proof
obligation left beyond the `decide` itself. -/
theorem leafBound_of_floorData {n : ℕ} {b : Fin n → Bool} {qc qd : Fin n → ℚ}
    {lamBq rminq : ℚ}
    (h : leafCheck (fun i => ⌊qc i * (scaleD : ℚ)⌋) (fun i => ⌊qd i * (scaleD : ℚ)⌋) b
            arcLlo arcLhi scaleD ⌈lamBq * (scaleD : ℚ)⌉ ⌊rminq * (scaleD : ℚ)⌋ threshSq
          = true) :
    (∑ i, ((qc i : ℝ) * (2 * Real.arcsin (((19 : ℚ) / 50 : ℚ) : ℝ)) + (qd i : ℝ)))
      - (lamBq : ℝ) + (rminq : ℝ) > ((thresh : ℚ) : ℝ) ^ 2 := by
  have key := leafBound_of_check h scaleD_pos arc_hyp_lo arc_hyp_hi arc_hyp_nonneg
    (fun i => floor_le_mul (qc i) scaleD) (fun i => floor_le_mul (qd i) scaleD)
    (mul_le_ceil lamBq scaleD) (floor_le_mul rminq scaleD) (mul_le_ceil (thresh ^ 2) scaleD)
  simpa using key

/-! ## 6. The BATCH (block) form: soundness with the missing sign check restored

The archived batch form (`evidence/g3-recon/OneThm_*.lean`) is the shape that actually passes
the gate at scale (200 leaves / 116 s).  Two things are needed to make it a *soundness* route
rather than a consistency check:

  (i)  its checker must imply the frozen `leafCheck` -- `leafCheck_eq_true_of_sum` below:
       the batch obligation IS `lsum = S` (all block sums) plus the final comparison, and the
       frozen checker is then `true`, so `leafCheck_sound_noSign` applies;
  (ii) the block walk must ALSO verify the sign table (see `scratch/L2_blockform_sign_hole.lean`
       for the kernel-checked counterexample that the archived version does not) --
       `signOK`, `blocksOK'` below, with `blocksOK'_sum` / `blocksOK'_sign` extracting
       exactly the two facts (i) needs.

The list bookkeeping is literal-free, as the Lead's design requires. -/

/-- one term of the scaled leaf sum, with the generator's sign branch -/
def stepT (Llo Lhi D : ℤ) (p : ℤ × ℤ × Bool) : ℤ :=
  p.1 * (if p.2.2 then Llo else Lhi) + p.2.1 * D

/-- the generator's partial-sum walk -/
def rSum (Llo Lhi D : ℤ) : List (ℤ × ℤ × Bool) → ℤ
  | [] => 0
  | p :: ps => stepT Llo Lhi D p + rSum Llo Lhi D ps

/-- literal-free concatenation identity (the `runSum_concat` of the approved design) -/
theorem rSum_append (Llo Lhi D : ℤ) (l₁ l₂ : List (ℤ × ℤ × Bool)) :
    rSum Llo Lhi D (l₁ ++ l₂) = rSum Llo Lhi D l₁ + rSum Llo Lhi D l₂ := by
  induction l₁ with
  | nil => simp [rSum]
  | cons p ps ih => simp [rSum, ih, add_assoc]

/-- **THE sign table that the archived batch checker omits** -/
def signOK : List (ℤ × ℤ × Bool) → Bool
  | [] => true
  | p :: ps => (p.2.2 == decide (0 < p.1)) && signOK ps

theorem signOK_append (l₁ l₂ : List (ℤ × ℤ × Bool)) :
    signOK (l₁ ++ l₂) = (signOK l₁ && signOK l₂) := by
  induction l₁ with
  | nil => simp [signOK]
  | cons p ps ih => simp [signOK, ih, Bool.and_assoc]

theorem signOK_of_forall (l : List (ℤ × ℤ × Bool))
    (h : ∀ p ∈ l, p.2.2 = decide (0 < p.1)) : signOK l = true := by
  induction l with
  | nil => rfl
  | cons p ps ih =>
      have hp : p.2.2 = decide (0 < p.1) := h p (by simp)
      have hps : ∀ q ∈ ps, q.2.2 = decide (0 < q.1) := fun q hq => h q (by simp [hq])
      simp [signOK, hp, ih hps]

/-- the block walk, WITH the sign table -/
def blocksOK' (Llo Lhi D : ℤ) : List (List (ℤ × ℤ × Bool)) → List ℤ → Bool
  | [], [] => true
  | b :: bs, s :: ss => decide (rSum Llo Lhi D b = s) && signOK b && blocksOK' Llo Lhi D bs ss
  | _, _ => false

theorem blocksOK'_sum (Llo Lhi D : ℤ) : ∀ (bs : List (List (ℤ × ℤ × Bool))) (ss : List ℤ),
    blocksOK' Llo Lhi D bs ss = true → ss.sum = (bs.map (rSum Llo Lhi D)).sum
  | [], [], _ => by simp
  | [], _ :: _, h => by simp [blocksOK'] at h
  | _ :: _, [], h => by simp [blocksOK'] at h
  | b :: bs, s :: ss, h => by
      rw [blocksOK', Bool.and_eq_true, Bool.and_eq_true] at h
      obtain ⟨⟨hs1, _hsign⟩, hrest⟩ := h
      have h1 : rSum Llo Lhi D b = s := by simpa using hs1
      have ih := blocksOK'_sum Llo Lhi D bs ss hrest
      simp [h1, ih]

theorem blocksOK'_sign (Llo Lhi D : ℤ) : ∀ (bs : List (List (ℤ × ℤ × Bool))) (ss : List ℤ),
    blocksOK' Llo Lhi D bs ss = true → signOK bs.flatten = true
  | [], [], _ => rfl
  | [], _ :: _, h => by simp [blocksOK'] at h
  | _ :: _, [], h => by simp [blocksOK'] at h
  | b :: bs, s :: ss, h => by
      rw [blocksOK', Bool.and_eq_true, Bool.and_eq_true] at h
      obtain ⟨⟨_hs1, hsign⟩, hrest⟩ := h
      have ih := blocksOK'_sign Llo Lhi D bs ss hrest
      simp only [List.flatten_cons]
      rw [signOK_append, hsign, ih, Bool.true_and]

/-- the generator's block tree sums to the flattened walk (literal-free) -/
theorem rSum_flatten (Llo Lhi D : ℤ) (bs : List (List (ℤ × ℤ × Bool))) :
    rSum Llo Lhi D bs.flatten = (bs.map (rSum Llo Lhi D)).sum := by
  induction bs with
  | nil => simp [rSum]
  | cons b bs ih => simp [rSum_append, ih]

/-- **The batch obligation IS the frozen checker.**  Once the batch walk has produced
`lsum = S` (its block sums) and the final comparison, `leafCheck` is `true`. -/
theorem leafCheck_eq_true_of_sum {n : ℕ} {c d : Fin n → ℤ} {b : Fin n → Bool}
    {Llo Lhi D lamB rmin T2 : ℤ} (S : ℤ)
    (hD : 0 < D) (hLH : Llo ≤ Lhi) (hs : ∀ i, b i = decide (0 < c i))
    (hsum : lsum c d Llo Lhi D = S) (hcmp : S - lamB * D + rmin * D > T2 * D) :
    leafCheck c d b Llo Lhi D lamB rmin T2 = true := by
  rw [leafCheck]
  simp only [Bool.and_eq_true, decide_eq_true_eq]
  exact ⟨⟨⟨hD, hLH⟩, hs⟩, by rw [hsum]; exact hcmp⟩

/-- **The batch checker** (the shape that passes the gate at scale): every block sum plus the
sign table, then the final comparison once.  Differs from the archived `leafOK` by `signOK`. -/
def leafOK' (Llo Lhi D lamB rmin T2 : ℤ) (bs : List (List (ℤ × ℤ × Bool)))
    (ss : List ℤ) : Bool :=
  blocksOK' Llo Lhi D bs ss && decide (ss.sum - lamB * D + rmin * D > T2 * D)

/-- What a passing batch check yields: the three facts the hookup consumes. -/
theorem leafOK'_spec {Llo Lhi D lamB rmin T2 : ℤ} {bs : List (List (ℤ × ℤ × Bool))}
    {ss : List ℤ} (h : leafOK' Llo Lhi D lamB rmin T2 bs ss = true) :
    ss.sum = (bs.map (rSum Llo Lhi D)).sum ∧ ss.sum - lamB * D + rmin * D > T2 * D
      ∧ signOK bs.flatten = true := by
  rw [leafOK', Bool.and_eq_true] at h
  obtain ⟨hblk, hcmp⟩ := h
  exact ⟨blocksOK'_sum Llo Lhi D bs ss hblk, by simpa using hcmp,
    blocksOK'_sign Llo Lhi D bs ss hblk⟩

/-- **The batch form's soundness, assembled**: a batch certificate (block sums + final
comparison, with the sign table verified) yields the leaf bound -- no per-leaf work beyond
the batch `decide`s. -/
theorem leafBound_of_batch {n : ℕ} {c d : Fin n → ℤ} {b : Fin n → Bool}
    {Llo Lhi D lamB rmin T2 : ℤ} {qc qd : Fin n → ℚ} {lamBR rminR T2R : ℚ} {L : ℝ} (S : ℤ)
    (hD : 0 < D) (hLH : Llo ≤ Lhi) (hs : ∀ i, b i = decide (0 < c i))
    (hsum : lsum c d Llo Lhi D = S) (hcmp : S - lamB * D + rmin * D > T2 * D)
    (hLlo : (Llo : ℝ) / (D : ℝ) ≤ L) (hLhi : L ≤ (Lhi : ℝ) / (D : ℝ))
    (hLlo0 : 0 ≤ (Llo : ℝ) / (D : ℝ))
    (hcR : ∀ i, (c i : ℚ) ≤ qc i * D) (hd : ∀ i, (d i : ℚ) ≤ qd i * D)
    (hlamB : lamBR * D ≤ (lamB : ℚ)) (hrmin : (rmin : ℚ) ≤ rminR * D)
    (hT2 : T2R * D ≤ (T2 : ℚ)) :
    (∑ i, ((qc i : ℝ) * L + (qd i : ℝ))) - (lamBR : ℝ) + (rminR : ℝ) > (T2R : ℝ) :=
  leafBound_of_check (leafCheck_eq_true_of_sum S hD hLH hs hsum hcmp)
    hD hLlo hLhi hLlo0 hcR hd hlamB hrmin hT2


end N11Formalization.G3LeafChecker
