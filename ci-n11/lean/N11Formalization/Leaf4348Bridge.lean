theorem i_le_j (k : Fin 36) : (N11Formalization.FlashCosineLeaf284Bridge.iOf k : ℕ) ≤ (N11Formalization.FlashCosineLeaf284Bridge.jOf k : ℕ) := by
  fin_cases k <;> norm_num [N11Formalization.FlashCosineLeaf284Bridge.iOf, N11Formalization.FlashCosineLeaf284Bridge.jOf]

/-- The bridge's `cl`/`cv` are the LP module's `cl`/`cv` (same literals): this is the kernel data
equality that lets `affine_lower` use the LP layer's `f0_sound`. -/
theorem cl_eq_lp (k : Fin 36) : cl k = N11Formalization.Leaf4348LP.cl k := by
  fin_cases k <;> norm_num [cl, N11Formalization.Leaf4348LP.cl]

theorem cv_eq_lp (k : Fin 36) : cv k = N11Formalization.Leaf4348LP.cv k := by
  fin_cases k <;> norm_num [cv, N11Formalization.Leaf4348LP.cv]

/-- The two pair coefficients, exactly as the affine form uses them. -/
theorem pair_coeff (k : Fin 36) :
    cl k = wt k * sl k * (((N11Formalization.FlashCosineLeaf284Bridge.iOf k : ℕ) : ℚ) - ((N11Formalization.FlashCosineLeaf284Bridge.jOf k : ℕ) : ℚ)) ∧
    cv k = wt k * cc k := by
  fin_cases k <;> norm_num [cl, cv, wt, sl, cc, N11Formalization.FlashCosineLeaf284Bridge.iOf, N11Formalization.FlashCosineLeaf284Bridge.jOf]

theorem zhat_eq (q : Fin 9) :
    zhat q = ∑ k : Fin 36, if (N11Formalization.FlashCosineLeaf284Bridge.iOf k : ℕ) ≤ (q : ℕ) ∧ (q : ℕ) < (N11Formalization.FlashCosineLeaf284Bridge.jOf k : ℕ)
      then wt k * sl k else 0 := by
  fin_cases q <;> simp [zhat, N11Formalization.FlashCosineLeaf284Bridge.iOf, N11Formalization.FlashCosineLeaf284Bridge.jOf, wt, sl, Fin.sum_univ_succ] <;> norm_num

/-- The DBM row of a pair, read in the `y` variables. -/
theorem rowAy (y : Fin 9 → ℝ) (r : Fin 1) :
    (∑ q : Fin 9, (rowA r q : ℝ) * y q) = tval y (rowTo r) - tval y (rowFrom r) := by
  fin_cases r <;>
    simp [rowA, rowA0, rowFrom, rowTo, tval, Fin.sum_univ_succ] <;> ring

theorem rows_of_cell (y : Fin 9 → ℝ)
    (hcell : N11Formalization.FlashLeafSplit.Cell (fun i j => (dbm i j : ℝ))
      (N11Formalization.FlashLeafSplit.tlift y)) :
    ∀ r : Fin 1, ∑ q : Fin 9, (rowA r q : ℝ) * y q ≤ (rowb r : ℝ) := by
  intro r
  rw [rowAy, rowb_dbm, tval_eq_tlift, tval_eq_tlift]
  exact hcell (rowFrom r) (rowTo r)

noncomputable def pairAffine (y : Fin 9 → ℝ) : ℝ :=
  ∑ k : Fin 36, (wt k : ℝ) * ((sl k : ℝ) * zval y (N11Formalization.FlashCosineLeaf284Bridge.iOf k) (N11Formalization.FlashCosineLeaf284Bridge.jOf k) + (cc k : ℝ))

theorem pair_expand (y : Fin 9 → ℝ) (k : Fin 36) :
    (wt k : ℝ) * ((sl k : ℝ) * zval y (N11Formalization.FlashCosineLeaf284Bridge.iOf k) (N11Formalization.FlashCosineLeaf284Bridge.jOf k) + (cc k : ℝ)) =
      (cl k : ℝ) * Lc + (cv k : ℝ) +
        Dc * (∑ q : Fin 9, if (N11Formalization.FlashCosineLeaf284Bridge.iOf k : ℕ) ≤ (q : ℕ) ∧ (q : ℕ) < (N11Formalization.FlashCosineLeaf284Bridge.jOf k : ℕ)
          then ((wt k : ℝ) * (sl k : ℝ)) * y q else 0) := by
  have hc : (cl k : ℝ) = (wt k : ℝ) * (sl k : ℝ) *
      (((N11Formalization.FlashCosineLeaf284Bridge.iOf k : ℕ) : ℝ) - ((N11Formalization.FlashCosineLeaf284Bridge.jOf k : ℕ) : ℝ)) := by exact_mod_cast (pair_coeff k).1
  have hv : (cv k : ℝ) = (wt k : ℝ) * (cc k : ℝ) := by exact_mod_cast (pair_coeff k).2
  rw [zval_eq, tval_sub y (i_le_j k), hc, hv]
  have hs : (∑ q : Fin 9, if (N11Formalization.FlashCosineLeaf284Bridge.iOf k : ℕ) ≤ (q : ℕ) ∧ (q : ℕ) < (N11Formalization.FlashCosineLeaf284Bridge.jOf k : ℕ)
          then ((wt k : ℝ) * (sl k : ℝ)) * y q else 0) =
      ((wt k : ℝ) * (sl k : ℝ)) *
        (∑ q : Fin 9, if (N11Formalization.FlashCosineLeaf284Bridge.iOf k : ℕ) ≤ (q : ℕ) ∧ (q : ℕ) < (N11Formalization.FlashCosineLeaf284Bridge.jOf k : ℕ) then y q else 0) := by
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun q _ => ?_
    split_ifs <;> simp
  rw [hs]
  simp only [Fin.val_castSucc]
  ring

noncomputable def affine (L D : ℝ) (y : Fin 9 → ℝ) : ℝ :=
  (∑ k : Fin 36, ((cl k : ℝ) * L + (cv k : ℝ))) + ∑ q : Fin 9, (D * (zhat q : ℝ)) * y q

/-- The LP-dual lower bound at the frozen brackets.  `hD` is the UPPER end (sign, see the header). -/
theorem affine_lower (L D : ℝ) (y : Fin 9 → ℝ)
    (hL : (Lq : ℝ) ≤ L ∧ L ≤ (LQ : ℝ)) (hD : (D : ℝ) ≤ (DQ : ℝ))
    (hy0 : ∀ q, 0 ≤ y q) (hy1 : ∑ q, y q = 1)
    (hrow : ∀ r : Fin 1, ∑ q : Fin 9, (rowA r q : ℝ) * y q ≤ (rowb r : ℝ)) :
    (lower4348 : ℝ) ≤ affine L D y := by
  have hp := lp_step9 rowA rowb lam (fun q => D * (zhat q : ℝ)) (m4348 : ℝ) y
    (fun r => by exact_mod_cast lam_nonneg r) hrow hy0 hy1 (reduced_cost D hD)
  have hb : (lamB : ℝ) = ∑ r : Fin 1, (lam r : ℝ) * (rowb r : ℝ) := by
    simp only [lamB, Rat.cast_sum, Rat.cast_mul]
  rw [← hb] at hp
  have hf := f0_sound L hL
  have hcl : ∀ k : Fin 36, (cl k : ℝ) = (N11Formalization.Leaf4348LP.cl k : ℝ) := fun k => by
    exact_mod_cast cl_eq_lp k
  have hcv : ∀ k : Fin 36, (cv k : ℝ) = (N11Formalization.Leaf4348LP.cv k : ℝ) := fun k => by
    exact_mod_cast cv_eq_lp k
  have he : (lower4348 : ℝ) = (f0Lo : ℝ) - (lamB : ℝ) + (m4348 : ℝ) := by
    simp only [lower4348, Rat.cast_add, Rat.cast_sub]
  unfold affine
  simp only [hcl, hcv]
  linarith

theorem affine_identity (y : Fin 9 → ℝ) : pairAffine y = affine Lc Dc y := by
  have hs : (∑ k : Fin 36, ∑ q : Fin 9,
      if (N11Formalization.FlashCosineLeaf284Bridge.iOf k : ℕ) ≤ (q : ℕ) ∧ (q : ℕ) < (N11Formalization.FlashCosineLeaf284Bridge.jOf k : ℕ)
        then ((wt k : ℝ) * (sl k : ℝ)) * y q else 0) =
      ∑ q : Fin 9, (zhat q : ℝ) * y q := by
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun q _ => ?_
    have hz : (zhat q : ℝ) = ∑ k : Fin 36,
        if (N11Formalization.FlashCosineLeaf284Bridge.iOf k : ℕ) ≤ (q : ℕ) ∧ (q : ℕ) < (N11Formalization.FlashCosineLeaf284Bridge.jOf k : ℕ)
          then (wt k : ℝ) * (sl k : ℝ) else 0 := by
      rw [zhat_eq]
      push_cast
      apply Finset.sum_congr rfl
      intro k hk
      split_ifs <;> push_cast <;> rfl
    rw [hz, Finset.sum_mul]
    refine Finset.sum_congr rfl fun k _ => ?_
    split_ifs <;> simp
  unfold pairAffine affine
  simp_rw [pair_expand]
  rw [Finset.sum_add_distrib, ← Finset.mul_sum, hs, Finset.mul_sum]
  simp only [mul_assoc]

/-- The payoff of this file: the frozen threshold is below the affine bound on the cell. -/
theorem affine_gt (L D : ℝ) (y : Fin 9 → ℝ)
    (hL : (Lq : ℝ) ≤ L ∧ L ≤ (LQ : ℝ)) (hD : (D : ℝ) ≤ (DQ : ℝ))
    (hy0 : ∀ q, 0 ≤ y q) (hy1 : ∑ q, y q = 1)
    (hrow : ∀ r : Fin 1, ∑ q : Fin 9, (rowA r q : ℝ) * y q ≤ (rowb r : ℝ)) :
    (T : ℝ) ^ 2 < affine L D y := by
  have h : (T : ℝ) ^ 2 < (lower4348 : ℝ) := by exact_mod_cast frozen_gt_T2
  exact lt_of_lt_of_le h (affine_lower L D y hL hD hy0 hy1 hrow)

