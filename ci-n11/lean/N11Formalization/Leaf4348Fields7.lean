def edgeIdx : Edge → Fin 51
  | .inl (i, s) => ⟨2 * i.val + s.val, by omega⟩
  | .inr (f, v) => ⟨18 + 3 * f.val + v.val, by omega⟩
def freeIdx : Free → Fin 22
  | .inl s => ⟨s.val, by omega⟩
  | .inr f => ⟨11 + f.val, by omega⟩
def aZ (f : Field) (e : Edge) : ℤ := aV f (edgeIdx e)
def HZ (f : Field) (v : Free) (j : Fin 9) : ℤ := HV f (freeIdx v) j
def incZ : Edge → Free → ℤ
  | .inl (i, _), v => if v = .inl ⟨i.val, by omega⟩ then 1 else 0
  | .inr (f, j), v => (if v = .inl (face f j) then 1 else 0) - (if v = .inr f then 1 else 0)
/-- Edge coefficients are defined from the harmonic matrix and actual network. -/
def bZ (f : Field) : Edge → Fin 9 → ℤ
  | .inl (i, side), j => HZ f (.inl ⟨i.val, by omega⟩) j - (if j = anchorIndex i side then D f else 0)
  | .inr (g, k), j => HZ f (.inl (face g k)) j - HZ f (.inr g) j

theorem A_pos : ∀ f : Field, 0 < A f := by decide +kernel
theorem D_pos : ∀ f : Field, 0 < D f := by decide +kernel
theorem a_pos : ∀ f : Field, ∀ e : Edge, 0 < aZ f e := by decide +kernel
theorem a_sum : ∀ f : Field, ∑ e, aZ f e = A f := by decide +kernel
theorem H_row : ∀ f : Field, ∀ v : Free, ∑ j, HZ f v j = D f := by decide +kernel
theorem bal_all : ∀ f : Field, ∀ v : Free, ∀ j : Fin 9,
    ∑ e, aZ f e * incZ e v * bZ f e j = 0 := by decide +kernel
theorem weight_identity : ∀ f : Field, ∀ k : Fin 36,
    (∑ e, aZ f e * bZ f e (iOf k) * bZ f e (jOf k)) * wDen f k =
      -(wNum f k) * A f * D f * D f := by decide +kernel
theorem den_pos : ∀ f : Field, ∀ k : Fin 36, 0 < wDen f k := by decide +kernel

noncomputable def αR (f : Field) (e : Edge) : ℝ := (aZ f e : ℝ) / (A f : ℝ)
noncomputable def HR (f : Field) (v : Free) (j : Fin 9) : ℝ := (HZ f v j : ℝ) / (D f : ℝ)
noncomputable def weight (f : Field) (k : Fin 36) : ℝ := (wNum f k : ℝ) / (wDen f k : ℝ)

theorem A_ne (f : Field) : (A f : ℝ) ≠ 0 := by exact_mod_cast (A_pos f).ne'
theorem D_ne (f : Field) : (D f : ℝ) ≠ 0 := by exact_mod_cast (D_pos f).ne'

theorem inc_cast (e : Edge) (v : Free) : ((incZ e v : ℤ) : ℝ) = incidence e v := by
  rcases e with ⟨i, s⟩ | ⟨f, j⟩ <;> simp [incZ, incidence] <;> split_ifs <;> simp

theorem coeff_eq (f : Field) (e : Edge) (j : Fin 9) :
    coeff (HR f) e j = (bZ f e j : ℝ) / (D f : ℝ) := by
  have hD := D_ne f
  rcases e with ⟨i, side⟩ | ⟨g, k⟩
  · simp only [coeff, bZ, HR]
    split_ifs
    all_goals (push_cast; field_simp)
    all_goals ring
  · simp only [coeff, bZ, HR]
    push_cast
    field_simp

theorem hα (f : Field) : ∀ e, 0 ≤ αR f e := fun e =>
  div_nonneg (by exact_mod_cast (a_pos f e).le) (by exact_mod_cast (A_pos f).le)

theorem hs (f : Field) : ∑ e, αR f e = 1 := by
  simp only [αR]
  rw [← Finset.sum_div]
  have h : (∑ e, (aZ f e : ℝ)) = (A f : ℝ) := by exact_mod_cast a_sum f
  rw [h, div_self (A_ne f)]

theorem hbal (f : Field) : ∀ v j, ∑ e, (αR f e * incidence e v) * coeff (HR f) e j = 0 := by
  intro v j
  have hc : ((∑ e, aZ f e * incZ e v * bZ f e j : ℤ) : ℝ) = 0 := by exact_mod_cast bal_all f v j
  push_cast at hc
  have hr : ∀ e, (αR f e * incidence e v) * coeff (HR f) e j =
      ((aZ f e : ℝ) * (incZ e v : ℝ) * (bZ f e j : ℝ)) / ((A f : ℝ) * (D f : ℝ)) := by
    intro e; rw [coeff_eq, ← inc_cast, αR]; ring
  simp_rw [hr, ← Finset.sum_div, hc, zero_div]

theorem hH (f : Field) : ∀ v, ∑ j, HR f v j = 1 := by
  intro v
  simp only [HR]
  rw [← Finset.sum_div]
  have h : (∑ j, (HZ f v j : ℝ)) = (D f : ℝ) := by exact_mod_cast H_row f v
  rw [h, div_self (D_ne f)]

theorem weight_eq_neg_gram (f : Field) (k : Fin 36) :
    weight f k = -gram (αR f) (HR f) (iOf k) (jOf k) := by
  have hW : (wDen f k : ℝ) ≠ 0 := by exact_mod_cast (den_pos f k).ne'
  have he : gram (αR f) (HR f) (iOf k) (jOf k) =
      (∑ e, (aZ f e : ℝ) * (bZ f e (iOf k) : ℝ) * (bZ f e (jOf k) : ℝ)) /
      ((A f : ℝ) * (D f : ℝ) * (D f : ℝ)) := by
    simp only [gram, αR, coeff_eq]
    rw [Finset.sum_div]
    apply Finset.sum_congr rfl
    intro e _
    ring
  have hw : (∑ e, (aZ f e : ℝ) * (bZ f e (iOf k) : ℝ) * (bZ f e (jOf k) : ℝ)) *
      (wDen f k : ℝ) = -(wNum f k : ℝ) * A f * D f * D f := by
    exact_mod_cast weight_identity f k
  rw [he, weight]
  rw [← neg_div, div_eq_div_iff hW (mul_ne_zero (mul_ne_zero (A_ne f) (D_ne f)) (D_ne f))]
  nlinarith only [hw]

/-- Actual 36 unordered pairs equal the upper triangular double sum. -/
theorem pairs_to_double (g : Fin 9 → Fin 9 → ℝ) :
    (∑ k : Fin 36, g (iOf k) (jOf k)) = ∑ i, ∑ j, if i < j then g i j else 0 := by
  simp [iOf, jOf, Fin.sum_univ_succ]
  <;> ring

noncomputable def fieldEnergy (f : Field) (θ : Fin 9 → ℝ) : ℝ :=
  2 * ∑ k : Fin 36, weight f k * (1 - Real.cos (θ (iOf k) - θ (jOf k)))

/-- A complete source-field-to-oracle consumer, with no stationarity premise. -/
theorem source_energy_le_oracle (f : Field) (θ : Fin 9 → ℝ) :
    fieldEnergy f θ ≤ V2 (fun j => circleMap (θ j)) := by
  unfold fieldEnergy
  simp_rw [weight_eq_neg_gram]
  rw [pairs_to_double (fun i j => -gram (αR f) (HR f) i j * (1 - Real.cos (θ i - θ j)))]
  exact cosine_energy_le_oracle (αR f) (HR f) (hα f) (hs f) (hbal f) (hH f) θ


def beta : Field → ℚ := ![((497142643059 : ℚ) / 1000000000000), ((35211753691 : ℚ) / 500000000000), ((19824765437 : ℚ) / 1000000000000), ((37275212351 : ℚ) / 1000000000000), ((154132508763 : ℚ) / 1000000000000), ((14606934373 : ℚ) / 500000000000), ((95993747131 : ℚ) / 500000000000)]
/-- The source's recorded per-pair mixture weights (36). -/
def wt : Fin 36 → ℚ := ![(( : ℚ) / ), (( : ℚ) / ), (( : ℚ) / ), (( : ℚ) / ), (( : ℚ) / ), (( : ℚ) / ), (( : ℚ) / ), (( : ℚ) / ), (( : ℚ) / ), (( : ℚ) / ), (( : ℚ) / ), (( : ℚ) / ), (( : ℚ) / ), (( : ℚ) / ), (( : ℚ) / ), (( : ℚ) / ), (( : ℚ) / ), (( : ℚ) / ), (( : ℚ) / ), (( : ℚ) / ), (( : ℚ) / ), (( : ℚ) / ), (( : ℚ) / ), (( : ℚ) / ), (( : ℚ) / ), (( : ℚ) / ), (( : ℚ) / ), (( : ℚ) / ), (( : ℚ) / ), (( : ℚ) / ), (( : ℚ) / ), (( : ℚ) / ), (( : ℚ) / ), (( : ℚ) / ), (( : ℚ) / ), (( : ℚ) / )]

theorem beta_nonneg (f : Field) : (0 : ℝ) ≤ (beta f : ℝ) := by
  fin_cases f <;> norm_num [beta]

/-- Real-cast form of `sum beta = 1`; the cast is done explicitly on the rational sum. -/
theorem beta_sum : (∑ f : Field, (beta f : ℝ)) = 1 := by
  have hq : (∑ f : Field, beta f) = 1 := by norm_num [beta, Fin.sum_univ_succ]
  exact_mod_cast hq

/-- Full leaf weight identity, INCLUDING the source energy factor 2. -/
theorem mixture_weights (k : Fin 36) :
    (wt k : ℝ) = ∑ f : Field, (beta f : ℝ) * 2 * weight f k := by
  fin_cases k <;> norm_num [beta, weight, wNum, wDen, wt, Fin.sum_univ_succ]

noncomputable def mixtureEnergy (θ : Fin 9 → ℝ) : ℝ :=
  ∑ f : Field, (beta f : ℝ) * fieldEnergy f θ

theorem mixture_le_oracle (θ : Fin 9 → ℝ) :
    mixtureEnergy θ ≤ V2 (fun j => circleMap (θ j)) := by
  calc
    mixtureEnergy θ ≤ ∑ f : Field, (beta f : ℝ) * V2 (fun j => circleMap (θ j)) := by
      apply Finset.sum_le_sum
      intro f _
      exact mul_le_mul_of_nonneg_left (source_energy_le_oracle f θ) (beta_nonneg f)
    _ = V2 (fun j => circleMap (θ j)) := by
      rw [← Finset.sum_mul, beta_sum, one_mul]

