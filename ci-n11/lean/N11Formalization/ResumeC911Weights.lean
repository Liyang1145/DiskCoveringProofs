set_option maxRecDepth 100000 in
set_option maxHeartbeats 2000000 in
theorem weight_identity : ∀ i j : Fin 9, i < j →
    (∑ e, aZ e * bZ e i * bZ e j) * wDen i j =
      -(wNum i j) * A * D i * D j := by decide +kernel

set_option maxRecDepth 100000 in
theorem den_pos : ∀ i j, 0 < wDen i j := by decide +kernel

noncomputable def weight (i j : Fin 9) : ℝ := (wNum i j : ℝ) / (wDen i j : ℝ)

theorem weight_eq_neg_gram (i j : Fin 9) (hij : i < j) :
    weight i j = -gram αR HR i j := by
  have hD1 : (D i : ℝ) ≠ 0 := by exact_mod_cast (D_pos i).ne'
  have hD2 : (D j : ℝ) ≠ 0 := by exact_mod_cast (D_pos j).ne'
  have hW : (wDen i j : ℝ) ≠ 0 := by exact_mod_cast (den_pos i j).ne'
  have he : gram αR HR i j =
      (∑ e, (aZ e : ℝ) * (bZ e i : ℝ) * (bZ e j : ℝ)) /
      ((A : ℝ) * (D i : ℝ) * (D j : ℝ)) := by
    simp only [gram, αR, coeff_eq]
    rw [Finset.sum_div]
    apply Finset.sum_congr rfl
    intro e _
    ring
  have hw : (∑ e, (aZ e : ℝ) * (bZ e i : ℝ) * (bZ e j : ℝ)) *
      (wDen i j : ℝ) = -(wNum i j : ℝ) * A * D i * D j := by
    exact_mod_cast weight_identity i j hij
  rw [he, weight]
  rw [← neg_div, div_eq_div_iff hW (mul_ne_zero (mul_ne_zero A_ne hD1) hD2)]
  nlinarith only [hw]

/-- Source field C911 in its actual 36-pair cosine representation bounds the
network oracle for every angular configuration, without Schur-shaped premises. -/
theorem c911_source_energy_le_oracle (θ : Fin 9 → ℝ) :
    (2 * ∑ i, ∑ j, if i < j then
      weight i j * (1 - Real.cos (θ i - θ j)) else 0) ≤
      V2 (fun j => circleMap (θ j)) := by
  have he : (∑ i, ∑ j, if i < j then weight i j * (1 - Real.cos (θ i - θ j)) else 0) =
      ∑ i, ∑ j, if i < j then -gram αR HR i j * (1 - Real.cos (θ i - θ j)) else 0 := by
    apply Finset.sum_congr rfl
    intro i _
    apply Finset.sum_congr rfl
    intro j _
    split_ifs with hij
    · rw [weight_eq_neg_gram i j hij]
    · rfl
  rw [he]
  exact cosine_energy_le_oracle αR HR hα hs hbal hH θ

#check @c911_source_energy_le_oracle
#print axioms c911_source_energy_le_oracle
#print axioms weight_identity
end N11Formalization.ResumeGlobal.C911Weights
