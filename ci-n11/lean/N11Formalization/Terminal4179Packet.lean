def PA (k : Fin 36) : ℚ := (packet k).a
def PB (k : Fin 36) : ℚ := (packet k).b
def slopeQ (k : Fin 36) : ℚ := (packet k).s
def interQ (k : Fin 36) : ℚ := (packet k).c
theorem beta_nonneg : ∀ f : Field,0 ≤ beta f := by decide +kernel
theorem beta_sum : (∑ f : Field,beta f)=1 := by decide +kernel
theorem rounded_nonneg : ∀ f : Field,∀ k : Fin 36,0 ≤ rounded f k := by decide +kernel
theorem W_nonneg (k : Fin 36) : 0 ≤ W k :=
  Finset.sum_nonneg (fun f _ => mul_nonneg (beta_nonneg f) (rounded_nonneg f k))
theorem lam_nonneg : ∀ a : Row,0 ≤ lam a := by decide +kernel
theorem terminal : (DBMSourceTree.data nodeID).terminal=true := by decide +kernel
theorem all_valid : ∀ k : Fin 36,CosineLinePacket.Valid (packet k) := by decide +kernel
theorem endpoint_binding : ∀ k : Fin 36,
    PA k ≤ ((iOf k).val-(jOf k).val : ℚ)*LQ+Dq*DBMAngleProvider.slo nodeID k ∧
    ((iOf k).val-(jOf k).val : ℚ)*Lq+DQ*DBMAngleProvider.shi nodeID k ≤ PB k := by
  decide +kernel
theorem reduced : ∀ q : Fin 9,rmin ≤
    endpointLo Dq DQ (g W slopeQ q)+rho rowFrom rowTo lam q := by decide +kernel
theorem numeric_check : FlashCosineLeaf284Bridge.T^2 <
    lower W slopeQ interQ nodeID rowFrom rowTo lam rmin := by decide +kernel
theorem pair_minorant (k : Fin 36) :
    ∀ z∈Set.Icc (PA k : ℝ) (PB k : ℝ),
      (slopeQ k : ℝ)*z+(interQ k : ℝ) ≤ 1-Real.cos z :=
  CosineLinePacket.minorant (packet k) (all_valid k)
