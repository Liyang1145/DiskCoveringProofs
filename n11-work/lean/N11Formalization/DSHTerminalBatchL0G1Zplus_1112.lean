/-! ## §5  The gamma layer: per-pair collapse, indexed pair-locally -/

/-- Collapsed slope of pair `k`: `Σ_li γ_li · s_li`. -/
def slopeQ (k : Fin 36) : ℚ := ∑ li : Fin (NK k), PG (LI k li) * PL (LI k li)

/-- Collapsed intercept of pair `k` (certified per-line drops already absorbed). -/
def interQ (k : Fin 36) : ℚ := ∑ li : Fin (NK k), PG (LI k li) * PC (LI k li)

theorem gamma_nonneg (k : Fin 36) : ∀ li : Fin (NK k), (0 : ℝ) ≤ (PG (LI k li) : ℝ) := by
  have hq : ∀ k : Fin 36, ∀ li : Fin (NK k), (0 : ℚ) ≤ PG (LI k li) := by
    decide +kernel
  intro li
  exact_mod_cast hq k li

theorem gamma_sum (k : Fin 36) : ∑ li : Fin (NK k), (PG (LI k li) : ℝ) = 1 := by
  have hq : ∀ k : Fin 36, (∑ li : Fin (NK k), PG (LI k li)) = (1 : ℚ) := by
    decide +kernel
  exact_mod_cast hq k

/-- **Per-pair collapsed minorant on the pair's ACTUAL cell interval.**  Consumes the 64 line
    theorems through the root-imported `FlashCosineMixture.gamma_mixture_minorant`. -/
theorem pair_minorant (k : Fin 36) :
    ∀ z ∈ Set.Icc (PA k : ℝ) (PB k : ℝ),
      (slopeQ k : ℝ) * z + (interQ k : ℝ) ≤ 1 - Real.cos z := by
  have hline : ∀ li : Fin (NK k), ∀ z' ∈ Set.Icc (PA k : ℝ) (PB k : ℝ),
      (PL (LI k li) : ℝ) * z' + (PC (LI k li) : ℝ) ≤ 1 - Real.cos z' := by
    intro li
    have h := all_lines (LI k li)
