theorem valid4 : MValid pk4 := by
  constructor <;> decide +kernel
def pk : Fin K → MPacket := ![pk2,pk2,pk2,pk3,pk4]
theorem pk_ok : ∀ l, (sub l).terminal = true → MValid (pk l) ∧ (pk l).D = (sub l).db ∧ (pk l).S = 1048576 := by
  intro l hl
  fin_cases l <;> first | exact absurd hl (by decide +kernel) | exact ⟨valid2, rfl, rfl⟩ | exact ⟨valid3, rfl, rfl⟩ | exact ⟨valid4, rfl, rfl⟩
theorem terminal : (DBMSourceTree.data 3800).terminal = true := by decide +kernel
theorem node_radius
    (y : Fin 9 → ℝ) (hy0 : ∀ q, 0 ≤ y q) (hy1 : ∑ q, y q = 1)
    (hc : FlashLeafSplit.Cell (DBMTreeKernel.matrix DBMSourceTree.data 4096 3800)
      (FlashLeafSplit.tlift y)) (C Z : Fin 11 → Point) (r : ℝ)
    (hf : ResumeNetwork.Feasible (SourceChartIsometry.chartAnchors y) C Z r) :
    SourceExactRoot.sourceRadius < r
  := Paid16MatrixCellCertificate.node_radius_of_refinement 3800 sub 0 sub_valid root_scaled pk pk_ok y hy0 hy1 hc C Z r hf
def newIDs : Finset (Fin 5011) := {3800}
theorem new_terminal (n : Fin 5011) (hn : n ∈ newIDs) : (DBMSourceTree.data n).terminal = true := by
  rw [Finset.mem_singleton.mp hn]; exact terminal
theorem new_radius (n : Fin 5011) (hn : n ∈ newIDs)
    (y : Fin 9 → ℝ) (hy0 : ∀ q, 0 ≤ y q) (hy1 : ∑ q, y q = 1)
    (hc : FlashLeafSplit.Cell (DBMTreeKernel.matrix DBMSourceTree.data 4096 n)
      (FlashLeafSplit.tlift y)) (C Z : Fin 11 → Point) (r : ℝ)
    (hf : ResumeNetwork.Feasible (SourceChartIsometry.chartAnchors y) C Z r) :
    SourceExactRoot.sourceRadius < r := by
  have hn' := Finset.mem_singleton.mp hn
  subst hn'
  exact node_radius y hy0 hy1 hc C Z r hf
end
