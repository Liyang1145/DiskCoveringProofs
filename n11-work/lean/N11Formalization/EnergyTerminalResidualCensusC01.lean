    EnergyTerminalBatchB07.paidIDs,
    EnergyTerminalBatchB06.paidIDs,
    EnergyTerminalBatchB05.paidIDs,
    EnergyTerminalBatchB04.paidIDs,
    EnergyTerminalBatchB03.paidIDs,
    EnergyTerminalBatchB02.paidIDs,
    EnergyTerminalBatchB01.paidIDs,
    Paid16GeneralFirst42.newIDs,
    Paid16GeneralRemaining210.newIDs,
    Paid16GeneralNext505.newIDs,
    Paid16GeneralNext1182.new_mem,
    Paid16GeneralNext1182S01.newIDs,
    Paid16GeneralNext1182S02.newIDs,
    Paid16GeneralNext1182S03.newIDs,
    Paid16GeneralNext1182S04.newIDs,
    Paid16GeneralNext1182S05.newIDs,
