/-- 左形式行和的最大值（= `certReal.numK`）。 -/
def numKz : ℤ := 19946860966006205741188599135001633955963666665903878784811725668159241556466988272194202862741857127470363604398406291969489667947880087496108395443381798033273769393617458489504190091493376

/-- 右形式行和的最大值。 -/
def numKRz : ℤ := 22700364679032765231565581516447512709677040614061204765572648469241402368839594574726402254723999795837662087728510563614299414758273800034689179552551500245033465324801219039842233231605760

/-- **真实证书（左形式 `hsum`）**。 -/
def certReal : HsumCert :=
  { D := Dz, numY := numYz, loNum := loNumz, hiNum := hiNumz, numK := numKz, denK := Ez }

/-- **真实证书（右形式 `hsumR`）**：同一份 `Y`/`J` 数据，换成右侧乘法顺序。 -/
def certRealR : HsumCert :=
  { D := Dz, numY := numYz, loNum := loNumz, hiNum := hiNumz, numK := numKRz, denK := Ez }

/-- 真实整数行和（左形式）逐行 ≤ `numKz`：12 条由 `decide` 分别核验。 -/
theorem certReal_rowZ_le (i : Fin 12) : certReal.rowZ i ≤ numKz := by
  fin_cases i <;> decide

/-- 真实整数行和（右形式）逐行 ≤ `numKRz`。 -/
theorem certRealR_rowZR_le (i : Fin 12) : certRealR.rowZR i ≤ numKRz := by
  fin_cases i <;> decide

/-- **真实 `hsum` 通过内核检查**（`decide`）。 -/
theorem certReal_check : certReal.check = true := by decide

/-- **真实 `hsumR` 通过内核检查**（同一份数据、右侧形式）。 -/
theorem certRealR_checkR : certRealR.checkR = true := by decide

/-- **真实 `hsum`**：`∀ i, Σ_j max |(krawczykMat Y J i j)·| ≤ K`，`K = numKz/Ez`。 -/
theorem certReal_hsum :
    ∀ i : Fin 12, ∑ j : Fin 12,
        max |((krawczykMat certReal.Yof certReal.Jof i j).lo : ℝ)|
          |((krawczykMat certReal.Yof certReal.Jof i j).hi : ℝ)|
        ≤ (certReal.numK : ℝ) / (certReal.denK : ℝ) :=
  (check_sound certReal_check).1

/-- **真实 `hsumR`**：右侧乘法顺序，`K' = numKRz/Ez`。 -/
theorem certReal_hsumR :
    ∀ i : Fin 12, ∑ j : Fin 12,
        max |((krawczykMatR certRealR.Jof certRealR.Yof i j).lo : ℝ)|
          |((krawczykMatR certRealR.Jof certRealR.Yof i j).hi : ℝ)|
        ≤ (certRealR.numK : ℝ) / (certRealR.denK : ℝ) :=
  (checkR_sound certRealR_checkR).1

/-- 真实 `hK1`：`K < 1`（左形式）。 -/
theorem certReal_K_lt_one : (certReal.numK : ℝ) / (certReal.denK : ℝ) < 1 :=
  (check_sound certReal_check).2.2

/-- 真实 `hK0`：`0 ≤ K`（左形式）。 -/
theorem certReal_K_nonneg : 0 ≤ (certReal.numK : ℝ) / (certReal.denK : ℝ) :=
  (check_sound certReal_check).2.1

/-- 真实 `hK'1`：`K' < 1`（右形式）。 -/
theorem certRealR_K_lt_one : (certRealR.numK : ℝ) / (certRealR.denK : ℝ) < 1 :=
  (checkR_sound certRealR_checkR).2.2

