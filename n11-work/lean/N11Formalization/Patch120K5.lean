theorem sq_le_sq_of_abs_le {x B : ℝ} (h : |x| ≤ B) : x ^ 2 ≤ B ^ 2 := by
  have hB : 0 ≤ B := (abs_nonneg x).trans h
  have h2 : |x| ^ 2 ≤ B ^ 2 := (sq_le_sq₀ (abs_nonneg x) hB).mpr h
  rwa [sq_abs] at h2

theorem sum_sq_le_sum_sq_filter {n : ℕ} (P : Fin n → Prop) [DecidablePred P]
    (f B : Fin n → ℝ) (h : ∀ k, P k → |f k| ≤ B k) :
    (∑ k ∈ Finset.univ.filter P, f k ^ 2) ≤ ∑ k ∈ Finset.univ.filter P, B k ^ 2 := by
  apply Finset.sum_le_sum
  intro k hk
  exact sq_le_sq_of_abs_le (h k (Finset.mem_filter.mp hk).2)

theorem linear_le_endpoints {m : ℕ} (c x lo hi : Fin m → ℝ)
    (hx : ∀ k, lo k ≤ x k ∧ x k ≤ hi k) :
    ∑ k, c k * x k ≤ ∑ k, (if 0 ≤ c k then c k * hi k else c k * lo k) := by
  apply Finset.sum_le_sum
  intro k _
  by_cases hc : 0 ≤ c k
  · rw [if_pos hc]
    exact mul_le_mul_of_nonneg_left (hx k).2 hc
  · rw [if_neg hc]
    exact mul_le_mul_of_nonpos_left (hx k).1 (le_of_not_ge hc)

