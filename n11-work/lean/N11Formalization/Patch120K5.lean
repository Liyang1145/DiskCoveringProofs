/-- **consumer-shaped corollary**: exactly the `hr : q ≤ 729/50000` slot of
`ResumeRelativeScalar.local_gain` / `ResumeCoercivityCertificate.directional_to_local_gain`
(q := sqrt of the 8 pinned perturbations). -/
theorem k5_q_sqrt_le {L PI a0 a1 a2 a3 : ℝ} {u : Fin 9 → ℝ}
    (hLq : (Lq : ℝ) ≤ L) (hLQ : L ≤ (LQ : ℝ)) (hPL : (PILO : ℝ) ≤ PI)
    (hPH : PI ≤ (PIHI : ℝ))
    (h0L : (a0lo : ℝ) ≤ a0) (h0H : a0 ≤ (a0hi : ℝ))
    (h1L : (a1lo : ℝ) ≤ a1) (h1H : a1 ≤ (a1hi : ℝ))
    (h2L : (a2lo : ℝ) ≤ a2) (h2H : a2 ≤ (a2hi : ℝ))
    (h3L : (a3lo : ℝ) ≤ a3) (h3H : a3 ≤ (a3hi : ℝ))
    (hu : ∀ i, i ≠ 6 → (k5lo i : ℝ) ≤ u i ∧ u i ≤ (k5hi i : ℝ)) :
    Real.sqrt
      ( (((0 : ℝ) - 6) * L - (9 * L - 2 * PI) * u 0 - (2*a0 + 2*a1 + 2*a2 - 2*PI)) ^ 2
      + (((1 : ℝ) - 6) * L - (9 * L - 2 * PI) * u 1 - (2*a0 + 2*a1 + 2*a2 + 2*a3 - 2*PI)) ^ 2
      + (((2 : ℝ) - 6) * L - (9 * L - 2 * PI) * u 2 - (-(2*a0 + 2*a1 + 2*a2 + 2*a3))) ^ 2
      + (((3 : ℝ) - 6) * L - (9 * L - 2 * PI) * u 3 - (-(2*a0 + 2*a1 + 2*a2))) ^ 2
      + (((4 : ℝ) - 6) * L - (9 * L - 2 * PI) * u 4 - (-(2*a0 + 2*a1))) ^ 2
      + (((5 : ℝ) - 6) * L - (9 * L - 2 * PI) * u 5 - (-(2*a0))) ^ 2
      + (((7 : ℝ) - 6) * L - (9 * L - 2 * PI) * u 7 - (2*a0)) ^ 2
      + (((8 : ℝ) - 6) * L - (9 * L - 2 * PI) * u 8 - (2*a0 + 2*a1)) ^ 2)
      ≤ (729 / 50000 : ℝ) := by
  rw [Real.sqrt_le_left (by norm_num : (0 : ℝ) ≤ 729 / 50000)]
  exact k5_q_le hLq hLQ hPL hPH h0L h0H h1L h1H h2L h2H h3L h3H hu

/-! ## 5. member interface: the finite literal table (960 checks = 120 cells x 8 coords) -/

/-- The frame kernel: the hull index `i : Fin 9` (i ≠ 6) is sent to the t-index `f9 i : Fin 10`
(`f9` is the `castSucc`-style embedding); the pinned coordinate is `t (f9 i) - t 6`. -/
def f9 (i : Fin 9) : Fin 10 := ⟨i.val, by omega⟩

theorem f9_injective : Function.Injective f9 := by
  intro a b h
  exact Fin.ext (by simpa [f9] using congrArg Fin.val h)

/-- The literal check for one (cluster, cell) pair: the cluster hull contains the cell's
own pinned range in the t-frame. -/
def memberOK (lo hi : Fin 9 → ℚ) (d : Fin 10 → Fin 10 → ℚ) : Prop :=
  ∀ i : Fin 9, i ≠ 6 → lo i ≤ -d (f9 i) 6 ∧ d 6 (f9 i) ≤ hi i

/-- Rows of the DBM cell (`t j - t i ≤ d i j`) plus the literal member table give the hull
membership consumed by `k5_q_le` (in the t-frame). -/
theorem cell_in_hull {d : Fin 10 → Fin 10 → ℚ} {lo hi : Fin 9 → ℚ} {t : Fin 10 → ℝ}
    (hm : memberOK lo hi d) (hcell : ∀ i j, t j - t i ≤ (d i j : ℝ)) :
    ∀ i : Fin 9, i ≠ 6 → (lo i : ℝ) ≤ t (f9 i) - t 6 ∧ t (f9 i) - t 6 ≤ (hi i : ℝ) := by
  intro i hne
  obtain ⟨h1, h2⟩ := hm i hne
  have h1R : (lo i : ℝ) ≤ -(((d (f9 i) 6 : ℚ)) : ℝ) := by exact_mod_cast h1
  have h2R : (((d 6 (f9 i) : ℚ)) : ℝ) ≤ (hi i : ℝ) := by exact_mod_cast h2
  have h3 : (t 6 - t (f9 i) : ℝ) ≤ (((d (f9 i) 6 : ℚ)) : ℝ) := hcell (f9 i) 6
  have h4 : (t (f9 i) - t 6 : ℝ) ≤ (((d 6 (f9 i) : ℚ)) : ℝ) := hcell 6 (f9 i)
  constructor <;> linarith


