/-! ## 10. 变异负对照：`rhoInterval` 的 `sqrt` 项换成常数 `1`

`rhoK = cos a − √(R² − sin²a)` 的第二个构件是**承重**的：把它换成常数 `1`，
第 0 分量的包络整体平移，**不再包含真值**（用正确包络 + 纯有理比较证明）。 -/

/-- 变异构件：`√(R² − sin²a)` 换成常数 `1`。 -/
def rhoIntervalMut (q : Fin 12 → ℚ) (k : Fin 9) : RatInterval :=
  sub (cosTot ((angleVecInterval q) k)) (ofRat 1)

/-- 变异版环盘中心（逐坐标）。 -/
def ringCenterIntervalMut (q : Fin 12 → ℚ) (k : Fin 9) : Fin 2 → RatInterval
  | 0 => mul (rhoIntervalMut q k) (cosTot ((thetaInterval (angleVecInterval q)) k))
  | 1 => mul (rhoIntervalMut q k) (sinTot ((thetaInterval (angleVecInterval q)) k))

/-- 变异版 `Uvec`（逐坐标）。 -/
def UvecIntervalMut (q : Fin 12 → ℚ) (k : Fin 9) : Fin 2 → RatInterval
  | 0 => sub (add ((ringCenterIntervalMut q k) 0) ((ringCenterIntervalMut q (k + 1)) 0))
      ((arcEndInterval q k) 0)
  | 1 => sub (add ((ringCenterIntervalMut q k) 1) ((ringCenterIntervalMut q (k + 1)) 1))
      ((arcEndInterval q k) 1)

/-- 变异版第 0 分量（其余构件保持原样）。 -/
def residualIntervalMut0 (q : Fin 12 → ℚ) : RatInterval :=
  sub (distInterval (UvecIntervalMut q 1) (hub1Interval q)) (ofRat (q 6))

