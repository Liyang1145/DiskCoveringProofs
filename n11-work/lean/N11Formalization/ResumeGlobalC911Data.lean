def αQ (e : Edge) : ℚ := alphaV (edgeIdx e)
def HQ (v : Free) (j : Fin 9) : ℚ := HV (freeIdx v) j

def incQ : Edge → Free → ℚ
  | .inl (i, _), v => if v = .inl ⟨i.val, by omega⟩ then 1 else 0
  | .inr (f, j), v => (if v = .inl (face f j) then 1 else 0) - (if v = .inr f then 1 else 0)

def anchorQ : Edge → Fin 9 → ℚ
  | .inl (i, s), j => if j = anchorIndex i s then 1 else 0
  | .inr _, _ => 0

def bQ (e : Edge) (j : Fin 9) : ℚ := (∑ v, incQ e v * HQ v j) - anchorQ e j

theorem bQ_def (e : Edge) (j : Fin 9) :
    bQ e j = (∑ v, incQ e v * HQ v j) - anchorQ e j := rfl

theorem incQ_cast (e : Edge) (v : Free) : ((incQ e v : ℚ) : ℝ) = incidence e v := by
  rcases e with ⟨i, s⟩ | ⟨f, j⟩ <;> simp [incQ, incidence] <;> split_ifs <;> simp

/-- calibration: one (v,j) balance entry. -/
theorem balance_cal : ∑ e, αQ e * incQ e (.inl 0) * bQ e 0 = 0 := by
  simp only [bQ, αQ, HQ, Fintype.sum_sum_type, Fintype.sum_prod_type, Fin.sum_univ_succ,
    Fin.sum_univ_zero, incQ, anchorQ, edgeIdx, freeIdx, face, anchorIndex]
  norm_num [alphaV, HV]

end N11Formalization.ResumeGlobal.C911

