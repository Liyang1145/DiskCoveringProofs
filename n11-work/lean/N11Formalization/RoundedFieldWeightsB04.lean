def weight (f : Fin 7) (k : Fin 36) : ℚ := (numerator f k : ℚ)/10000000000
def mix (b : Fin 7 → ℚ) (k : Fin 36) : ℚ := ∑ f : Fin 7,b f*weight f k
theorem weight_nonneg : ∀ f : Fin 7,∀ k : Fin 36,0 ≤ weight f k := by decide +kernel
theorem weight_le : ∀ f : Fin 7,∀ k : Fin 36,
    weight f k ≤ 2*ConvexMinorantCore.weightQ f k := by decide +kernel
theorem mix_nonneg (b : Fin 7 → ℚ) (hb : ∀ f,0 ≤ b f) (k : Fin 36) : 0 ≤ mix b k :=
  Finset.sum_nonneg (fun f _ => mul_nonneg (hb f) (weight_nonneg f k))
theorem mix_le (b : Fin 7 → ℚ) (hb : ∀ f,0 ≤ b f) (k : Fin 36) :
    mix b k ≤ ConvexMinorantCore.mixWeight b k := by
  unfold mix ConvexMinorantCore.mixWeight
  apply Finset.sum_le_sum
  intro f _
  simpa only [mul_assoc] using mul_le_mul_of_nonneg_left (weight_le f k) (hb f)
end
end N11Formalization.RoundedFieldWeightsB04
