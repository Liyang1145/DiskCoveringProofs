import N11Formalization.SevenClassQ0Deg3RelabelledTableCertificate

/-! Lane A: strict rational total for the canonical q0 degree-three table.
Generated by `ops/lanes/A/emit_q0_degree3_strict_total.py`.  The canonical
21-edge/9-sector ledger is compared exactly with `piLo`, then connected to
the relabelled certificate's fixed-grid strict premise. -/
set_option autoImplicit false
noncomputable section
namespace N11Formalization.SevenClassQ0Deg3StrictTotal

open ActualFiniteNearestRefinement
open MetricAreaRationalCertificate
open SevenClassQ0Deg3
open SevenClassQ0Deg3TableBounds
open SevenClassQ0Deg3UpperTables

def totalCoeff : ℚ := 2*((∑ j : Fin 11, mu j)-lam)

theorem piProductUpper_totalCoeff :
    piProductUpper totalCoeff = totalCoeff * RatInterval.piLo := by
  have hneg : totalCoeff < 0 := by
    unfold totalCoeff
    norm_num [mu, lam]
  unfold piProductUpper
  rw [if_pos hneg]

theorem canonicalTableTotal_eq_ledger :
    SevenClassQ0Deg3RelabelledTableCertificate.canonicalTableTotal =
      totalCoeff * RatInterval.piLo +
        (∑ i : Fin 21,
          (edgeMaxAt i + ((19/50 : ℚ)^2 + |∑ j ∈ tableEdges i, mu j|) *
            RatInterval.piHi / 2048)) +
        (∑ i : Fin 9,
          (sectorMax i + (1 + lam + |mu (nextSite i)|) *
            RatInterval.piHi / 2048)) := by
  unfold SevenClassQ0Deg3RelabelledTableCertificate.canonicalTableTotal
  rw [piProductUpper_totalCoeff]

