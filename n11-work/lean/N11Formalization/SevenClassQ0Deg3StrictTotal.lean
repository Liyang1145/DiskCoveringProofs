]

def sectorBoundAt : Fin 9 → ℚ := ![
  (134128/1000000 : ℚ),
  (134128/1000000 : ℚ),
  (264176/1000000 : ℚ),
  (232711/1000000 : ℚ),
  (239076/1000000 : ℚ),
  (237515/1000000 : ℚ),
  (239075/1000000 : ℚ),
  (232711/1000000 : ℚ),
  (264175/1000000 : ℚ)
