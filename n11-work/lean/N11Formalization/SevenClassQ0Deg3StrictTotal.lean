theorem totalCoeff_lt_neg : totalCoeff ≤ -(319/1000) := by
  unfold totalCoeff
  norm_num [mu, lam]

theorem lam_lt_fifth : lam ≤ 1/5 := by
  norm_num [lam]

theorem mu_abs_lt_twentieth (j : Fin 11) : |mu j| ≤ 1/20 := by
  fin_cases j <;> norm_num [mu]

theorem tableEdges_card (i : Fin 21) : (tableEdges i).card = 2 := by
  fin_cases i <;> decide

theorem tableEdge_sum_abs (i : Fin 21) :
    |∑ j ∈ tableEdges i, mu j| ≤ 1/10 := by
  calc
    |∑ j ∈ tableEdges i, mu j| ≤ ∑ j ∈ tableEdges i, |mu j| :=
      Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ _j ∈ tableEdges i, (1/20 : ℚ) :=
      Finset.sum_le_sum fun j _ => mu_abs_lt_twentieth j
    _ = (tableEdges i).card * (1/20 : ℚ) := by simp
    _ = 1/10 := by rw [tableEdges_card]; norm_num

theorem edgeMaxAt_le (i : Fin 21) : edgeMaxAt i ≤ edgeBoundAt i := by
  fin_cases i <;> norm_num [edgeMaxAt, edgeBoundAt]

theorem sectorMax_le (i : Fin 9) : sectorMax i ≤ sectorBoundAt i := by
  fin_cases i <;> norm_num [sectorMax, sectorBoundAt]

theorem edgeMax_sum_le : (∑ i : Fin 21, edgeMaxAt i) ≤ 2134315/1000000 := by
  calc
    (∑ i : Fin 21, edgeMaxAt i) ≤ ∑ i : Fin 21, edgeBoundAt i :=
      Finset.sum_le_sum fun i _ => edgeMaxAt_le i
    _ ≤ 2134315/1000000 := by norm_num [edgeBoundAt]

theorem sectorMax_sum_le : (∑ i : Fin 9, sectorMax i) ≤ 1977695/1000000 := by
  calc
    (∑ i : Fin 9, sectorMax i) ≤ ∑ i : Fin 9, sectorBoundAt i :=
      Finset.sum_le_sum fun i _ => sectorMax_le i
    _ ≤ 1977695/1000000 := by norm_num [sectorBoundAt]

theorem edge_increment_sum_le :
    (∑ i : Fin 21,
      ((19/50 : ℚ)^2 + |∑ j ∈ tableEdges i, mu j|) * RatInterval.piHi / 2048) ≤ 8/1000 := by
  calc
    (∑ i : Fin 21,
      ((19/50 : ℚ)^2 + |∑ j ∈ tableEdges i, mu j|) * RatInterval.piHi / 2048) ≤
        ∑ _i : Fin 21, ((611/2500 : ℚ) * RatInterval.piHi / 2048) := by
      apply Finset.sum_le_sum
      intro i _
      have hi := tableEdge_sum_abs i
      have h : (19/50 : ℚ)^2 + |∑ j ∈ tableEdges i, mu j| ≤ 611/2500 := by
        linarith
      exact mul_le_mul_of_nonneg_right h (by norm_num [RatInterval.piHi])
    _ ≤ 8/1000 := by norm_num [RatInterval.piHi]

theorem sector_increment_sum_le :
    (∑ i : Fin 9, (1 + lam + |mu (nextSite i)|) * RatInterval.piHi / 2048) ≤ 18/1000 := by
  calc
    (∑ i : Fin 9, (1 + lam + |mu (nextSite i)|) * RatInterval.piHi / 2048) ≤
        ∑ _i : Fin 9, ((5/4 : ℚ) * RatInterval.piHi / 2048) := by
      apply Finset.sum_le_sum
      intro i _
      have hm := mu_abs_lt_twentieth (nextSite i)
      have hl := lam_lt_fifth
      have h : 1 + lam + |mu (nextSite i)| ≤ 5/4 := by linarith
      exact mul_le_mul_of_nonneg_right h (by norm_num [RatInterval.piHi])
    _ ≤ 18/1000 := by norm_num [RatInterval.piHi]

/-- Pure arithmetic comparison of the explicit coefficient ledger with `piLo`. -/
theorem canonicalLedger_lt_piLo :
    totalCoeff * RatInterval.piLo +
      (∑ i : Fin 21,
        (edgeMaxAt i + ((19/50 : ℚ)^2 + |∑ j ∈ tableEdges i, mu j|) *
          RatInterval.piHi / 2048)) +
      (∑ i : Fin 9,
        (sectorMax i + (1 + lam + |mu (nextSite i)|) *
          RatInterval.piHi / 2048)) < RatInterval.piLo := by
  have hcoeff : totalCoeff * RatInterval.piLo ≤ -1 := by
    have hc := totalCoeff_lt_neg
    have hpi : (0 : ℚ) ≤ RatInterval.piLo := by norm_num [RatInterval.piLo]
    have hmul : totalCoeff * RatInterval.piLo ≤ (-(319/1000) : ℚ) * RatInterval.piLo :=
      mul_le_mul_of_nonneg_right hc hpi
    have hnum : (-(319/1000) : ℚ) * RatInterval.piLo ≤ -1 := by
      norm_num [RatInterval.piLo]
    exact hmul.trans hnum
  have he := edgeMax_sum_le
  have hs := sectorMax_sum_le
  have hei := edge_increment_sum_le
  have hsi := sector_increment_sum_le
  have hpi : (3.14159265358979323846 : ℚ) ≤ RatInterval.piLo := by
    norm_num [RatInterval.piLo]
  have hsum : totalCoeff * RatInterval.piLo +
      (∑ i : Fin 21,
        (edgeMaxAt i + ((19/50 : ℚ)^2 + |∑ j ∈ tableEdges i, mu j|) *
          RatInterval.piHi / 2048)) +
      (∑ i : Fin 9,
        (sectorMax i + (1 + lam + |mu (nextSite i)|) *
          RatInterval.piHi / 2048)) ≤
      -1 + 2134315/1000000 + 8/1000 + 1977695/1000000 + 18/1000 := by
    simp_rw [Finset.sum_add_distrib]
    nlinarith
  have hconst : -1 + 2134315/1000000 + 8/1000 + 1977695/1000000 + 18/1000 <
      (3.14159265358979323846 : ℚ) := by norm_num
  exact hsum.trans_lt (hconst.trans_le hpi)

/-- The canonical 21-edge/9-sector table ledger is strictly below `piLo`. -/
theorem canonicalTableTotal_lt_piLo :
    SevenClassQ0Deg3RelabelledTableCertificate.canonicalTableTotal <
      RatInterval.piLo := by
  rw [canonicalTableTotal_eq_ledger]
  exact canonicalLedger_lt_piLo

/-- The exact canonical table arithmetic discharges the degree-three area input. -/
theorem q0Degree3AreaInput : Q0Degree3AreaInput :=
  SevenClassQ0Deg3RelabelledTableCertificate.q0Degree3AreaInput_of_strictTotal
    (by
      intro c r h hr R O hrun
      exact canonicalTableTotal_lt_piLo)

end N11Formalization.SevenClassQ0Deg3StrictTotal
