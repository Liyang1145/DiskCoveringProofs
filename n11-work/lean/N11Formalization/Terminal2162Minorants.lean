/-! ## §2  The rules beyond the two imported ones

    (3) increasing arc with `s ≤ sin` throughout (left bracket): `1 - cos z - s*z` increases on
        `[a,b]`, so its minimum sits at the LEFT endpoint; reduces to the root-imported
        `FlashCosine.minorant_of_le_sin`.

    (4) arc inside `[-π, 0]` with `sin ≤ s` throughout (right bracket): `1 - cos z - s*z`
        decreases on `[a,b]`, so its minimum sits at the RIGHT endpoint; reduces to the
        root-imported `FlashCosine.minorant_of_sin_le` with the sign lemma
        `Real.sin_nonpos_of_nonpos_of_neg_pi_le`. -/

theorem rational_inc_left {a b s c : ℚ} (hab : a ≤ b)
    (hm : MonotoneOn Real.sin (Set.Icc (a : ℝ) (b : ℝ)))
    (hs : s ≤ sinLoNLag a)
    (hc : c ≤ 1 - cosHiNLag a - s * a) :
    ∀ z ∈ Set.Icc (a : ℝ) (b : ℝ), (s : ℝ) * z + (c : ℝ) ≤ 1 - Real.cos z := by
  have hsR : (s : ℝ) ≤ (sinLoNLag a : ℝ) := by exact_mod_cast hs
  have habR : (a : ℝ) ≤ (b : ℝ) := by exact_mod_cast hab
  have hsin : ∀ t ∈ Set.Icc (a : ℝ) (b : ℝ), (s : ℝ) ≤ Real.sin t := by
    intro t ht
    exact le_trans hsR (le_trans (sinLoNLag_le_sin a) (hm ⟨le_rfl, habR⟩ ht ht.1))
  have hcR : (c : ℝ) ≤ 1 - (cosHiNLag a : ℝ) - (s : ℝ) * (a : ℝ) := by exact_mod_cast hc
  exact FlashCosine.minorant_of_le_sin hsin (by linarith [cos_le_cosHiNLag a])

theorem rational_dec_right {a b s c : ℚ}
    (hsin : ∀ t ∈ Set.Icc (a : ℝ) (b : ℝ), Real.sin t ≤ (s : ℝ))
    (hc : c ≤ 1 - cosHiNLag b - s * b) :
    ∀ z ∈ Set.Icc (a : ℝ) (b : ℝ), (s : ℝ) * z + (c : ℝ) ≤ 1 - Real.cos z := by
  have hcR : (c : ℝ) ≤ 1 - (cosHiNLag b : ℝ) - (s : ℝ) * (b : ℝ) := by exact_mod_cast hc
  exact FlashCosine.minorant_of_sin_le hsin (by linarith [cos_le_cosHiNLag b])

theorem right_sin_bound {a b s : ℚ} (hab : a ≤ b)
    (hm : MonotoneOn Real.sin (Set.Icc (a : ℝ) (b : ℝ)))
    (hs : sinHiNLag b ≤ s) :
    ∀ t ∈ Set.Icc (a : ℝ) (b : ℝ), Real.sin t ≤ (s : ℝ) := by
  intro t ht
  have hb : (b : ℝ) ∈ Set.Icc (a : ℝ) (b : ℝ) := ⟨by exact_mod_cast hab,le_rfl⟩
  have hsin := hm ht hb ht.2
  have hsR : (sinHiNLag b : ℝ) ≤ (s : ℝ) := by exact_mod_cast hs
  exact hsin.trans ((sin_le_sinHiNLag b).trans hsR)

