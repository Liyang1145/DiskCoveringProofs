  norm_num [RatInterval.piLo, RatInterval.piHi] at hpLo hpHi
  have hm := FlashCosineSupport.monotone_sin_arc
    (a := (PA 34 : ℝ)) (b := (PB 34 : ℝ)) (m := (0 : ℤ))
    (by norm_num [PA, PB]; linarith [hpLo, hpHi])
    (by norm_num [PA, PB]; linarith [hpLo, hpHi])
  apply FlashCosineLeaf284Energy.rational_inc (a := PA 34) (b := PB 34) (s := PL 34) (c := PC 34) (t := PT 34) (e := PE 34) hm
  · norm_num [PA, PB, PT]
  · norm_num [PE]
  · norm_num [PL, PE, PT, sinLoNLag, sinTQ, Finset.sum_range_succ]
  · norm_num [PL, PE, PT, sinHiNLag, sinTQ, Finset.sum_range_succ]
  · norm_num [PC, PL, PE, PT, PA, PB, cosHiNLag, cosTQ, Finset.sum_range_succ]

/-- line 35: pair 35, line 0, rule `endpoint-fallback`. -/
theorem line_35 :
    ∀ z ∈ Set.Icc (PA 35 : ℝ) (PB 35 : ℝ),
      (PL 35 : ℝ) * z + (PC 35 : ℝ) ≤ 1 - Real.cos z := by
  have hpLo := RatInterval.piLo_lt_pi
  have hpHi := RatInterval.pi_lt_piHi
  norm_num [RatInterval.piLo, RatInterval.piHi] at hpLo hpHi
  have hm := FlashCosineSupport.monotone_sin_arc
    (a := (PA 35 : ℝ)) (b := (PB 35 : ℝ)) (m := (0 : ℤ))
    (by norm_num [PA, PB]; linarith [hpLo, hpHi])
    (by norm_num [PA, PB]; linarith [hpLo, hpHi])
  have hsin : ∀ t ∈ Set.Icc (PA 35 : ℝ) (PB 35 : ℝ), Real.sin t ≤ (PL 35 : ℝ) := by
    exact right_sin_bound (PA_le_PB 35) hm
      (by norm_num [PL,PB,sinHiNLag,sinTQ,Finset.sum_range_succ])
  apply rational_dec_right (a := PA 35) (b := PB 35) (s := PL 35) (c := PC 35)
    hsin
  · norm_num [PC, PL, PB, cosHiNLag, cosTQ, Finset.sum_range_succ]

